{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "OxideVault",
  "version": "0.1.0-alpha.1",
  "identifier": "dev.oxidevault.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "OxideVault — Rust Knowledge Graph & Hybrid Notes",
        "width": 1380,
        "height": 880,
        "minWidth": 960,
        "minHeight": 640
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "shortDescription": "Local-first Rust Knowledge Graph & Hybrid Markdown Notes (Alpha)",
    "category": "Productivity",
    "copyright": "Copyright (c) 2026 OxideVault Contributors",
    "license": "MIT",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
